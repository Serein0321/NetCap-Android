<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#B3C5FF</item>
        <item name="android:windowBackground">#14151D</item>
        <item name="android:colorBackground">#14151D</item>
        <item name="android:colorBackgroundFloating">#282A35</item>
        <item name="android:statusBarColor">#14151D</item>
        <item name="android:navigationBarColor">#14151D</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="OverlayTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:alertDialogTheme">@style/OverlayDialogTheme</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#B3C5FF</item>
        <item name="android:colorBackground">#282A35</item>
        <item name="android:colorBackgroundFloating">#282A35</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
    <style name="OverlayDialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#B3C5FF</item>
        <item name="android:colorBackground">#282A35</item>
        <item name="android:colorBackgroundFloating">#282A35</item>
        <item name="android:windowBackground">@drawable/bg_modal</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
</resources>
